+      const name = String(input).replace(/^\//, "");
+      if (online && name.startsWith("topics/") && fs.existsSync(path.join(PUBLIC, name))) {
+        return new Response(read(name), { status: 200, headers: { "Content-Type": "application/json" } });
+      }
+      return base(input, init);
+    }),
+  );
+}
+
