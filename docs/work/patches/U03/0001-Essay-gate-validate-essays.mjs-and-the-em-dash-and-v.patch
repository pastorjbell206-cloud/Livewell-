+  slug: PENDING,
+  title: "A Seeded Essay for the Gate",
+  excerpt: "One plain sentence about what this seeded essay is for.",
+  body,
+  updated: "2026-10-26",
+  ...extra,
+});
+
+let tmp = "";
+const dirs = { good: "", bad: "", noRef: "" };
