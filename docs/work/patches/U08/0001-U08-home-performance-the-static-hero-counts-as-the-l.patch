+import { describe, it, expect, vi, beforeEach, afterEach } from "vitest";
+import { mountAfterStaticHero } from "./static-hero";
+
+/** A PerformanceObserver stand-in the test can feed LCP entries to. */
+function fakeObserver(supported: string[] = ["largest-contentful-paint"]) {
+  const instances: FakeObserver[] = [];
+  class FakeObserver {
+    static supportedEntryTypes = supported;
+    callback: PerformanceObserverCallback;
+    observed: PerformanceObserverInit | null = null;
+    disconnected = false;
+    constructor(callback: PerformanceObserverCallback) {
+      this.callback = callback;
+      instances.push(this);
+    }
+    observe(init: PerformanceObserverInit) {
+      this.observed = init;
+    }
+    disconnect() {
+      this.disconnected = true;
+    }
+    takeRecords() {
+      return [];
+    }
+    /** Deliver LCP entries for these elements, as the browser would. */
+    emit(...elements: Element[]) {
+      const entries = elements.map((element) => ({ entryType: "largest-contentful-paint", element }));
+      this.callback(
+        { getEntries: () => entries } as unknown as PerformanceObserverEntryList,
+        this as unknown as PerformanceObserver
+      );
+    }
+  }
+  return { Observer: FakeObserver as unknown as typeof PerformanceObserver, instances };
+}
+
+/** The prerendered "/" shell: the masthead bar and the static hero. */
+function renderShell() {
+  document.body.innerHTML = `
+    <div id="root"><div id="lw-shell">
+      <div class="lw-shell-bar"><span>LiveWell</span></div>
+      <section class="home-hero"><div class="home-hero__inner">
+        <h1 class="home-hero__title">Headline</h1>
+        <p class="home-hero__text">Why the site exists.</p>
+      </div></section>
+    </div></div>`;
+  return {
+    bar: document.querySelector(".lw-shell-bar span")!,
+    text: document.querySelector(".home-hero__text")!,
+  };
+}
+
+function setVisibility(state: DocumentVisibilityState) {
+  Object.defineProperty(document, "visibilityState", { value: state, configurable: true });
+}
+
+beforeEach(() => {
+  vi.useFakeTimers();
+  setVisibility("visible");
+});
+
+afterEach(() => {
+  vi.useRealTimers();
+  document.body.innerHTML = "";
+});
+
+describe("mountAfterStaticHero", () => {
+  it("mounts at once on a page without the static hero", () => {
+    document.body.innerHTML = `<div id="root"><div id="lw-shell"></div></div>`;
+    const { Observer, instances } = fakeObserver();
+    const mount = vi.fn();
+    mountAfterStaticHero(mount, { path: "/", Observer });
+    expect(mount).toHaveBeenCalledTimes(1);
+    expect(instances).toHaveLength(0);
+  });
+
+  it("mounts at once on any other path, even though the fallback HTML carries the hero", () => {
+    renderShell();
+    const { Observer, instances } = fakeObserver();
+    const mount = vi.fn();
+    mountAfterStaticHero(mount, { path: "/admin", Observer });
+    expect(mount).toHaveBeenCalledTimes(1);
+    expect(instances).toHaveLength(0);
+  });
+
+  it("mounts at once where the browser has no LCP or no PerformanceObserver", () => {
+    renderShell();
+    const noLcp = vi.fn();
+    mountAfterStaticHero(noLcp, { path: "/", Observer: fakeObserver(["paint"]).Observer });
+    expect(noLcp).toHaveBeenCalledTimes(1);
+
+    const noObserver = vi.fn();
+    vi.stubGlobal("PerformanceObserver", undefined);
+    try {
+      mountAfterStaticHero(noObserver, { path: "/" });
+    } finally {
+      vi.unstubAllGlobals();
+    }
+    expect(noObserver).toHaveBeenCalledTimes(1);
+  });
+
+  it("mounts at once in a tab that is not visible (no LCP is reported there)", () => {
+    renderShell();
+    setVisibility("hidden");
+    const mount = vi.fn();
+    mountAfterStaticHero(mount, { path: "/", Observer: fakeObserver().Observer });
+    expect(mount).toHaveBeenCalledTimes(1);
+  });
+
+  it("on '/', waits for the hero's LCP entry, then mounts once and stops observing", () => {
+    const { text } = renderShell();
+    const { Observer, instances } = fakeObserver();
+    const mount = vi.fn();
+    mountAfterStaticHero(mount, { path: "/", Observer });
+
+    expect(mount).not.toHaveBeenCalled();
+    const [observer] = instances;
+    expect(observer.observed).toEqual({ type: "largest-contentful-paint", buffered: true });
+
+    observer.emit(text);
+    expect(mount).toHaveBeenCalledTimes(1);
+    expect(observer.disconnected).toBe(true);
+
+    // A later entry, or the timer, never mounts a second time.
+    observer.emit(text);
+    vi.advanceTimersByTime(1000);
+    expect(mount).toHaveBeenCalledTimes(1);
+  });
+
+  it("does not count a paint outside the hero (the masthead), and falls back to the timer", () => {
+    const { bar } = renderShell();
+    const { Observer, instances } = fakeObserver();
+    const mount = vi.fn();
+    mountAfterStaticHero(mount, { path: "/", Observer, maxWaitMs: 300 });
+
+    instances[0].emit(bar);
+    expect(mount).not.toHaveBeenCalled();
+
+    vi.advanceTimersByTime(299);
+    expect(mount).not.toHaveBeenCalled();
+    vi.advanceTimersByTime(1);
+    expect(mount).toHaveBeenCalledTimes(1);
+    expect(instances[0].disconnected).toBe(true);
+  });
+});
diff --git a/client/src/lib/static-hero.ts b/client/src/lib/static-hero.ts
new file mode 100644
index 00000000..19ed7cf9
--- /dev/null
+++ b/client/src/lib/static-hero.ts
@@ -0,0 +1,72 @@
+/**
+ * Mount the app only once the static home hero's paint has been recorded.
+ *
+ * scripts/prerender-heads.mjs writes the home hero into the HTML of "/" so
+ * the largest paint on the front page is the first paint. But when the
+ * bundle arrives quickly (a fast connection, or a cached bundle on a return
+ * visit), React replaced that HTML within a frame of its first paint, before
+ * Chrome had recorded when the frame reached the screen. Chrome then drops
+ * the static paragraph as a Largest Contentful Paint candidate and counts
+ * React's identical copy instead, so LCP waits on the whole bundle. That is
+ * why the home Lighthouse step failed on main (performance 73 to 88; U08).
+ *
+ * So on "/", where the static hero is the real page, wait for an LCP entry
+ * inside it. It is usually already buffered by the time the bundle runs;
+ * otherwise it comes a frame or two later; never wait longer than
+ * `maxWaitMs`. Every other path mounts at once: vercel.json serves the home
+ * HTML (hero included) for any path without its own prerendered file, and
+ * there the hero must not be held on screen. A browser without LCP, and a tab
+ * that is not visible (which reports no LCP), mount at once too.
+ */
+export interface StaticHeroOptions {
+  doc?: Document;
+  path?: string;
+  Observer?: typeof PerformanceObserver;
+  maxWaitMs?: number;
+}
+
+/** The static hero's root, present only in the prerendered "/" before mount. */
+export const STATIC_HERO_SELECTOR = "#lw-shell .home-hero";
+
+export function mountAfterStaticHero(mount: () => void, options: StaticHeroOptions = {}): void {
+  const doc = options.doc ?? document;
+  const path = options.path ?? doc.location?.pathname ?? "";
+  const Observer =
+    options.Observer ?? (typeof PerformanceObserver === "undefined" ? undefined : PerformanceObserver);
+  const maxWaitMs = options.maxWaitMs ?? 300;
+
+  const hero = doc.querySelector(STATIC_HERO_SELECTOR);
+  const lcpSupported = Observer?.supportedEntryTypes?.includes("largest-contentful-paint") ?? false;
+  if (path !== "/" || !hero || !Observer || !lcpSupported || doc.visibilityState !== "visible") {
+    mount();
+    return;
+  }
+
+  let done = false;
+  let observer: PerformanceObserver | null = null;
+  let timer: ReturnType<typeof setTimeout> | null = null;
+  const go = () => {
+    if (done) return;
+    done = true;
+    observer?.disconnect();
+    if (timer !== null) clearTimeout(timer);
+    mount();
+  };
+
+  try {
+    observer = new Observer((list) => {
+      const painted = list
+        .getEntries()
+        .some((entry) => {
+          const el = (entry as LargestContentfulPaint).element;
+          return el != null && hero.contains(el);
+        });
+      if (painted) go();
+    });
+    observer.observe({ type: "largest-contentful-paint", buffered: true });
+  } catch {
+    go();
+    return;
+  }
+  timer = setTimeout(go, maxWaitMs);
+}
