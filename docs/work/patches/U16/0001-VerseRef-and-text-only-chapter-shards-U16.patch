+    fs.mkdirSync(path.join(src, book), { recursive: true });
+    fs.copyFileSync(path.join(SRC_DIR, book, `${n}.json`), path.join(src, book, `${n}.json`));
+  }
+});
+
+afterEach(() => {
+  if (tmp) fs.rmSync(tmp, { recursive: true, force: true });
+});
