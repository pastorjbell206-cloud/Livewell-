 client/src/pages/ArticleDetail.test.tsx | 4 ++++
 client/src/pages/ArticleDetail.tsx      | 7 +++++--
 3 files changed, 15 insertions(+), 2 deletions(-)

diff --git a/client/src/lib/esv.ts b/client/src/lib/esv.ts
