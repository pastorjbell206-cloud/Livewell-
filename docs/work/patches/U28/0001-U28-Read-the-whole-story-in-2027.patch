+    for (const [slug, a, b] of d.read ?? [])
+      for (let c = a; c <= b; c++) if (actOf.has(`${slug}/${c}`) && actOf.get(`${slug}/${c}`) !== d.act) problems.push(`day ${n} crosses into another act at ${slug} ${c}`);
