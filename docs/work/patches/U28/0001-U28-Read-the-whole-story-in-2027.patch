new file mode 100644
index 00000000..684a2a48
--- /dev/null
+++ b/client/src/lib/storyPlan.test.ts
@@ -0,0 +1,138 @@
+/**
+ * Read the whole story in 2027 (U28): the committed schedule walks every
+ * chapter of the Bible once, in story order, in 365 days that each resolve to
+ * real chapters; dates map to days in the reader's own calendar; and the
+ * reader's place is kept on this device, guarded against corrupt storage.
+ */
+import { afterEach, describe, expect, it } from "vitest";
+import fs from "node:fs";
+import path from "node:path";
+
+import { planProblems } from "../../../scripts/lib/story-plan.mjs";
+import {
+  PLAN_DAYS,
+  PLAN_PROGRESS_KEY,
+  chaptersOf,
+  dateForDay,
+  dayFromQuery,
+  longDate,
+  nextUnreadDay,
+  openingDay,
+  planDayFor,
+  planMonths,
+  readPlanDays,
+  setPlanDay,
+  type StoryPlan,
+} from "./storyPlan";
+
+const PUBLIC = path.resolve(__dirname, "../../public");
+const PLAN: StoryPlan = JSON.parse(fs.readFileSync(path.join(PUBLIC, "bible/guides/whole-story-2027.json"), "utf8"));
+const BOOKS: { slug: string; chapters: number }[] = JSON.parse(fs.readFileSync(path.join(PUBLIC, "bible/books.json"), "utf8"));
+
+afterEach(() => localStorage.clear());
+
+describe("the committed plan", () => {
+  it("is sound by the generator's own checks", () => {
+    expect(planProblems(PLAN)).toEqual([]);
+  });
+
+  it("resolves day 1 to day 365 to real chapters, every chapter once", () => {
+    expect(PLAN.days).toHaveLength(PLAN_DAYS);
+    const seen = new Set<string>();
+    PLAN.days.forEach((d, i) => {
+      const chapters = chaptersOf(d);
+      expect(chapters.length, `day ${i + 1}`).toBeGreaterThan(0);
+      for (const c of chapters) {
+        const book = BOOKS.find((b) => b.slug === c.slug);
+        expect(book, `day ${i + 1}: ${c.slug}`).toBeTruthy();
+        expect(c.chapter).toBeGreaterThanOrEqual(1);
+        expect(c.chapter).toBeLessThanOrEqual(book!.chapters);
+        expect(fs.existsSync(path.join(PUBLIC, "bible/ch", c.slug, `${c.chapter}.json`)), `${c.slug} ${c.chapter}`).toBe(true);
+        expect(c.title, `${c.slug} ${c.chapter} has a title`).not.toBe("");
+        seen.add(`${c.slug}/${c.chapter}`);
+      }
+    });
+    expect(seen.size).toBe(1189);
+    expect(PLAN.chapters).toBe(1189);
+  });
+
+  it("starts in Genesis, ends in Revelation, and opens each act on a day of its own", () => {
+    expect(PLAN.days[0].read[0]).toEqual(["genesis", 1, 2]);
+    expect(PLAN.days[PLAN_DAYS - 1].read.at(-1)).toEqual(["revelation", 20, 22]);
+    expect(PLAN.acts).toHaveLength(11);
+    for (const a of PLAN.acts) expect(PLAN.days[a.day - 1].act).toBe(a.id);
+  });
+
+  it("places every context guide on one day, with a real guide behind it", () => {
+    const placed = PLAN.days.flatMap((d) => d.guides);
+    expect(new Set(placed).size).toBe(placed.length);
+    expect(placed.length).toBe(PLAN.guides.length);
+    for (const g of PLAN.guides) expect(fs.existsSync(path.join(PUBLIC, "context/guides", `${g.slug}.json`))).toBe(true);
+    // The day that reads Jeremiah 29 offers the guide to Jeremiah 29:11.
+    const jer29 = PLAN.days.find((d) => chaptersOf(d).some((c) => c.slug === "jeremiah" && c.chapter === 29))!;
+    expect(jer29.guides).toContain("jeremiah-29-11-in-context");
+  });
+});
+
+describe("days and dates", () => {
+  it("counts January 1, 2027 as day 1 and December 31 as day 365, across the clock change", () => {
+    expect(planDayFor(new Date(2027, 0, 1, 0, 5))).toBe(1);
+    expect(planDayFor(new Date(2027, 0, 1, 23, 55))).toBe(1);
+    expect(planDayFor(new Date(2027, 2, 15, 7))).toBe(74); // after the spring clock change
+    expect(planDayFor(new Date(2027, 11, 31, 22))).toBe(365);
+    expect(planDayFor(new Date(2026, 11, 31))).toBe(0);
+    expect(planDayFor(new Date(2028, 0, 1))).toBe(366);
+  });
+
+  it("dates a day in the reader's calendar", () => {
+    expect(dateForDay(1).toDateString()).toBe(new Date(2027, 0, 1).toDateString());
+    expect(dateForDay(60).toDateString()).toBe(new Date(2027, 2, 1).toDateString());
+    expect(longDate(1)).toBe("Friday, January 1");
+  });
+
+  it("splits the year into twelve months that cover every day once", () => {
+    const months = planMonths();
+    expect(months).toHaveLength(12);
+    expect(months[0]).toEqual({ name: "January", first: 1, last: 31 });
+    expect(months[1]).toEqual({ name: "February", first: 32, last: 59 });
+    expect(months[11].last).toBe(365);
+    for (let i = 1; i < 12; i++) expect(months[i].first).toBe(months[i - 1].last + 1);
+  });
+
+  it("reads a day from the address only when it is a real day", () => {
+    expect(dayFromQuery("?day=40")).toBe(40);
+    expect(dayFromQuery("day=365")).toBe(365);
+    for (const bad of ["?day=0", "?day=366", "?day=abc", "?day=4.5", ""]) expect(dayFromQuery(bad)).toBeNull();
+  });
+});
+
+describe("the reader's place", () => {
+  it("keeps the days marked read on this device", () => {
+    expect(readPlanDays().size).toBe(0);
+    expect(setPlanDay(2, true)).toBe(true);
+    expect(setPlanDay(1, true)).toBe(true);
+    expect(JSON.parse(localStorage.getItem(PLAN_PROGRESS_KEY)!)).toEqual([1, 2]);
+    setPlanDay(2, false);
+    expect([...readPlanDays()]).toEqual([1]);
+  });
+
+  it("ignores storage it cannot trust", () => {
+    localStorage.setItem(PLAN_PROGRESS_KEY, "{oops");
+    expect(readPlanDays().size).toBe(0);
+    localStorage.setItem(PLAN_PROGRESS_KEY, JSON.stringify([1, 400]));
+    expect(readPlanDays().size).toBe(0);
+  });
+
+  it("names the first day not yet read, and nothing once all are", () => {
+    expect(nextUnreadDay(new Set([1, 2, 4]))).toBe(3);
+    expect(nextUnreadDay(new Set(Array.from({ length: PLAN_DAYS }, (_, i) => i + 1)))).toBeNull();
+  });
+
+  it("opens on the address, then the reader's place, then today, then day 1", () => {
+    expect(openingDay(90, new Set([1]), 40)).toBe(90);
+    expect(openingDay(null, new Set([1, 2]), 40)).toBe(3);
+    expect(openingDay(null, new Set(), 40)).toBe(40);
+    expect(openingDay(null, new Set(), -65)).toBe(1);
+    expect(openingDay(null, new Set(), 366)).toBe(1);
+  });
+});
diff --git a/client/src/lib/storyPlan.ts b/client/src/lib/storyPlan.ts
new file mode 100644
index 00000000..047ff8f0
--- /dev/null
+++ b/client/src/lib/storyPlan.ts
@@ -0,0 +1,146 @@
+/**
+ * "Read the whole story in 2027": the Study Bible's story path in 365 days
+ * (pages/StudyBibleYear.tsx at /study/bible/guides/whole-story-2027).
+ *
+ * The schedule is generated and committed (scripts/build-story-plan.mjs →
+ * /bible/guides/whole-story-2027.json); this module reads it, says which day a
+ * date falls on, and keeps the reader's own place on this device. The days are
+ * numbered as well as dated, so a reader who starts late or misses a week
+ * keeps a place, not a debt: the page shows where they are, never how far
+ * behind.
+ */
+import { fetchJson } from "@/lib/fetch-json";
+import { isArrayOf, readStoredJSON, writeStoredJSON } from "@/lib/storage";
+
+export const PLAN_PATH = "/study/bible/guides/whole-story-2027";
+export const PLAN_YEAR = 2027;
+export const PLAN_DAYS = 365;
+
+export interface PlanAct {
+  id: string;
+  /** "Act Four" */
+  act: string;
+  title: string;
+  /** The day the act begins. */
+  day: number;
+}
+
+export interface PlanDay {
+  act: string;
+  /** "Genesis 1–3" */
+  label: string;
+  /** Runs of chapters within one book: [slug, from, to]. */
+  read: [string, number, number][];
+  /** One title per chapter, in order. */
+  titles: string[];
+  /** Context guides (slugs) that belong to the day. */
+  guides: string[];
+}
+
+export interface StoryPlan {
+  id: string;
+  start: string;
+  chapters: number;
+  books: Record<string, string>;
+  acts: PlanAct[];
+  guides: { slug: string; title: string }[];
+  days: PlanDay[];
+}
+
+const obj = (x: unknown): x is Record<string, unknown> => typeof x === "object" && x !== null && !Array.isArray(x);
+const isPlan = (x: unknown): x is StoryPlan =>
+  obj(x) && Array.isArray(x.days) && x.days.length === PLAN_DAYS && Array.isArray(x.acts) && Array.isArray(x.guides) && obj(x.books);
+
+let cached: Promise<StoryPlan> | null = null;
+export function fetchStoryPlan(): Promise<StoryPlan> {
+  if (!cached) {
+    cached = fetchJson("/bible/guides/whole-story-2027.json", isPlan).catch((e) => {
+      cached = null;
+      throw e;
+    });
+  }
+  return cached;
+}
+
+/** Whole days from January 1 of the plan's year to `date`'s calendar day, plus one (so January 1 is day 1). */
+export function planDayFor(date: Date): number {
+  const start = Date.UTC(PLAN_YEAR, 0, 1);
+  const today = Date.UTC(date.getFullYear(), date.getMonth(), date.getDate());
+  return Math.round((today - start) / 86_400_000) + 1;
+}
+
+/** The calendar day of a plan day (local). */
+export function dateForDay(day: number): Date {
+  return new Date(PLAN_YEAR, 0, day);
+}
+
+/** "Friday, January 1" */
+export function longDate(day: number): string {
+  return dateForDay(day).toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" });
+}
+
+/** "Jan 1" */
+export function shortDate(day: number): string {
+  return dateForDay(day).toLocaleDateString("en-US", { month: "short", day: "numeric" });
+}
+
+/** A day number from the address (?day=40), or null. */
+export function dayFromQuery(search: string): number | null {
+  const raw = new URLSearchParams(search).get("day");
+  if (!raw || !/^\d{1,3}$/.test(raw)) return null;
+  const n = Number(raw);
+  return n >= 1 && n <= PLAN_DAYS ? n : null;
+}
+
+/** Each chapter of a day: { slug, chapter, title }. */
+export function chaptersOf(day: PlanDay): { slug: string; chapter: number; title: string }[] {
+  const out: { slug: string; chapter: number; title: string }[] = [];
+  for (const [slug, from, to] of day.read) for (let c = from; c <= to; c++) out.push({ slug, chapter: c, title: day.titles[out.length] ?? "" });
+  return out;
+}
+
+/** The months of the plan's year: name, first day, last day. */
+export function planMonths(): { name: string; first: number; last: number }[] {
+  const out: { name: string; first: number; last: number }[] = [];
+  for (let m = 0; m < 12; m++) {
+    const first = planDayFor(new Date(PLAN_YEAR, m, 1));
+    const last = planDayFor(new Date(PLAN_YEAR, m + 1, 0));
+    out.push({ name: new Date(PLAN_YEAR, m, 1).toLocaleDateString("en-US", { month: "long" }), first, last });
+  }
+  return out;
+}
+
+// ── the reader's place (this device only) ───────────────────────────────────
+
+export const PLAN_PROGRESS_KEY = "livewell-progress-story-2027";
+const isDays = isArrayOf((x: unknown): x is number => Number.isInteger(x) && (x as number) >= 1 && (x as number) <= PLAN_DAYS);
+
+/** The days marked read on this device. */
+export function readPlanDays(): Set<number> {
+  return new Set(readStoredJSON<number[]>(PLAN_PROGRESS_KEY, isDays, []));
+}
+
+/** Mark a day read or unread; false when the browser won't store it. */
+export function setPlanDay(day: number, read: boolean): boolean {
+  const s = readPlanDays();
+  if (read) s.add(day);
+  else s.delete(day);
+  return writeStoredJSON(PLAN_PROGRESS_KEY, Array.from(s).sort((a, b) => a - b));
+}
+
+/** The reader's place: the first day not yet marked read, or null when every day is. */
+export function nextUnreadDay(done: Set<number>): number | null {
+  for (let d = 1; d <= PLAN_DAYS; d++) if (!done.has(d)) return d;
+  return null;
+}
+
+/**
+ * The day the page opens on: the one in the address; else the reader's place
+ * on this device; else today's day while the plan's year runs; else day 1.
+ */
+export function openingDay(query: number | null, done: Set<number>, today: number): number {
+  if (query) return query;
+  if (done.size) return nextUnreadDay(done) ?? PLAN_DAYS;
+  if (today >= 1 && today <= PLAN_DAYS) return today;
+  return 1;
+}
