+/**
+ * /study/bible/guides/whole-story-2027   Read the whole story in 2027
+ *
+ * The Study Bible's story path (every chapter once, in the order the story
+ * happened) cut into 365 days of about the same length, generated by
+ * scripts/build-story-plan.mjs (lib/storyPlan). The page opens on one day:
+ * the one in the address (?day=40), else the reader's place on this device,
+ * else today's day in 2027, else day 1. Each day lists its chapters (each
+ * opens in the Study Bible on the story path), the context guide that
+ * belongs to it, and a plain "Mark day read". Below, the year by month.
+ *
+ * Position, never performance: the page says which day the reader is on and
+ * which day the calendar is on, and never how far behind anyone is. A daily
+ * reminder goes into the reader's own calendar (RemindMe), starting January 1.
+ */
+import { useEffect, useRef, useState } from "react";
+import { Link, useLocation, useSearch } from "wouter";
+import { ArrowLeft, ArrowRight, Check } from "lucide-react";
+
+import Layout from "@/components/Layout";
+import { SEOMeta } from "@/components/SEOMeta";
+import { LoadFailed } from "@/components/LoadFailed";
+import { RemindMe } from "@/components/RemindMe";
+import { SAVE_FAILED } from "@/components/TakeItWithYou";
+import { PageHead } from "@/components/editorial/PageHead";
+import { Position } from "@/components/study/Position";
+import { chapterHref } from "@/lib/bible";
+import {
+  PLAN_DAYS,
+  PLAN_PATH,
+  chaptersOf,
+  dayFromQuery,
+  dateForDay,
+  fetchStoryPlan,
+  longDate,
