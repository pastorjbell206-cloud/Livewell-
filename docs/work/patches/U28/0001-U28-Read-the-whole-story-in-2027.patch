+  const [done, setDone] = useState(() => readPlanDays());
+  const [today] = useState(() => planDayFor(new Date()));
+  const [saveFailed, setSaveFailed] = useState(false);
+  // Without a day in the address, the page opens on the reader's place and stays
+  // on that day while they mark it read, rather than jumping ahead under their thumb.
+  const [opened] = useState(() => openingDay(null, done, today));
+  const day = dayFromQuery(search) ?? opened;
