From 8fa2bdf70a5ad60d2b2d4c83d2bad183af3b0ed1 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 26 Oct 2026 22:34:59 +0000
Subject: [PATCH 2/2] U14 review: PageHead eyebrow takes its flex display;
 sheet body drops the inset when a footer carries it

.pg-head__eyebrow{display:flex} was dead: .eyebrow{display:inline-flex}
sits later in index.css at the same specificity, so the eyebrow stayed an
inline box in a body-sized line. Two classes now outrank it.

With a footer, the sheet body and the footer both padded for the
safe-area inset, doubling the space above the home indicator on iPhones.
The body keeps 20px when it is not the last child.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01JuCQ8kZ25i9zRwNgk6bh4e
---
 client/src/index.css | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/client/src/index.css b/client/src/index.css
index 0da7f51d..c444b626 100644
--- a/client/src/index.css
+++ b/client/src/index.css
@@ -529,7 +529,9 @@ img{display:block;max-width:100%}
  * the page below. */
 .pg-head{background:var(--bone);padding:var(--s-5) clamp(16px,4vw,var(--s-4)) 0}
 .pg-head__inner{max-width:var(--pg-w,var(--w-default));margin:0 auto;padding-bottom:var(--s-4);border-bottom:1px solid var(--border)}
-.pg-head__eyebrow{display:flex;margin:0 0 14px}
+.pg-head__eyebrow{margin:0 0 14px}
+/* Two classes, so it outranks .eyebrow's inline-flex further down the file. */
+.eyebrow.pg-head__eyebrow{display:flex}
 .pg-head__title{font-family:var(--F);font-size:clamp(36px,4.4vw,56px);font-weight:400;line-height:1.06;letter-spacing:-0.02em;color:var(--ink);margin:0;max-width:22ch;text-wrap:balance}
 .pg-head__title:focus{outline:none}
 .pg-head__lede{font-family:var(--B);font-size:clamp(17px,1.3vw,19px);line-height:1.6;color:var(--ink-muted);max-width:60ch;margin:14px 0 0;text-wrap:pretty}
@@ -573,6 +575,8 @@ img{display:block;max-width:100%}
 .st-sheet__close{flex-shrink:0;min-height:44px;min-width:44px;padding:0 14px;font-family:var(--U);font-size:14px;font-weight:500;color:var(--ink);background:transparent;border:1px solid var(--border);border-radius:var(--radius-sm);transition:border-color .2s var(--motion-ease)}
 .st-sheet__close:hover{border-color:var(--ink)}
 .st-sheet__body{flex:1;min-height:0;overflow-y:auto;overscroll-behavior:contain;padding:16px 16px max(20px,env(safe-area-inset-bottom))}
+/* With a footer below it, the footer carries the safe-area inset, not the body too. */
+.st-sheet__body:not(:last-child){padding-bottom:20px}
 .st-sheet__foot{display:flex;flex-wrap:wrap;gap:12px;padding:12px 16px max(12px,env(safe-area-inset-bottom));border-top:1px solid var(--border)}
 @media (min-width:1024px){
   .st-sheet{top:0;left:auto;max-width:none;width:min(440px,100vw);max-height:none;margin:0;border-top:0;border-left:1px solid var(--border);border-radius:0;animation-name:st-slide}
