{
    "buildCommand": "rm -rf node_modules/.vite .vite dist && pnpm run sitemap && pnpm run build && pnpm run prerender",
    "outputDirectory": "dist/public",
    "installCommand": "pnpm install --no-frozen-lockfile",
    "headers": [
          {
                  "source": "/(.*)",
                  "headers": [
                            { "key": "X-Content-Type-Options", "value": "nosniff" },
                            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
                            { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
                            { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
                            { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
                            { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com; connect-src 'self' https://va.vercel-scripts.com https://vitals.vercel-insights.com; upgrade-insecure-requests" }
                  ]
          }
    ],
    "redirects": [
          { "source": "/articles", "destination": "/writing", "permanent": true },
          { "source": "/articles/:slug", "destination": "/writing/:slug", "permanent": true },
          { "source": "/for-families", "destination": "/parenting", "permanent": true },
          { "source": "/books-store", "destination": "/books", "permanent": true },
          {
                  "source": "/(.*)",
                  "has": [{ "type": "host", "value": "livewellbyjamesbell.co" }],
                  "destination": "https://www.livewellbyjamesbell.co/$1",
                  "permanent": true
          }
    ],
    "rewrites": [
          { "source": "/api/(.*)", "destination": "/api/index.ts" },
          { "source": "/rss.xml", "destination": "/api/index.ts" },
          { "source": "/feed", "destination": "/api/index.ts" },
          { "source": "/feed.xml", "destination": "/api/index.ts" },
          { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
    ]
}
