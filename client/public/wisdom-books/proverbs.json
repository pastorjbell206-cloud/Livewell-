{
 "book": "proverbs",
 "name": "Proverbs",
 "about": "Source of the Wisdom Books Explorer (/tools/wisdom-books). Each verse of Proverbs is tagged by hand with one or more themes; 'heading' marks a collection's heading. Verse text is never typed here: scripts/build-wisdom-books-index.mjs fills it from the BSB. noteTheme names a theme in the Study Bible's introduction to Proverbs (client/public/bible/notes/proverbs/intro.json), shown word for word.",
 "themes": [
  {
   "id": "fear",
   "name": "The fear of the LORD",
   "line": "Where the book says wisdom begins: reverence for the LORD, and what it does in a life.",
   "noteTheme": "The fear of the LORD",
   "deeper": [
    "the-fear-of-the-lord"
   ]
  },
  {
   "id": "wisdom",
   "name": "Wisdom and her call",
   "line": "Wisdom calling in the streets, her worth above silver and gold, and her place beside God when he made the world.",
   "noteTheme": "Wisdom personified",
   "deeper": ["decisions-and-guidance", "knowing-gods-will"]
  },
  {
   "id": "ways",
   "name": "The two ways",
   "line": "The path of the righteous and the path of the wicked, and where each one ends.",
   "noteTheme": "Two ways",
   "deeper": ["temptation", "obedience"]
  },
  {
   "id": "lord",
   "name": "The LORD who sees and directs",
   "line": "The plans people make, and the LORD who weighs hearts, directs steps and has the last word.",
   "deeper": ["gods-sovereignty", "trusting-god"]
  },
  {
   "id": "teach",
   "name": "Listening, correction and counsel",
   "line": "Receiving instruction, taking a rebuke, and seeking many counselors before a plan.",
   "deeper": ["being-discipled", "defensiveness"]
  },
  {
   "id": "fool",
   "name": "The fool, the mocker and the simple",
   "line": "The people Proverbs warns about, and the same tendencies in the reader: the closed mind, the scornful one and the easily led.",
   "deeper": ["stubbornness", "immaturity"]
  },
  {
   "id": "speech",
   "name": "Words and the tongue",
   "line": "Honest and lying lips, gentle and harsh answers, gossip, flattery, and the wisdom of holding your tongue.",
   "noteTheme": "Words and speech",
   "deeper": [
    "gossip-and-the-tongue",
    "lying",
    "crude-talk"
   ]
  },
  {
   "id": "anger",
   "name": "Anger, quarrels and peace",
   "line": "The hot temper and the slow one, how quarrels start and spread, and how they are calmed.",
   "deeper": ["anger", "conflict-with-others"]
  },
  {
   "id": "pride",
   "name": "Pride and humility",
   "line": "Haughty eyes, being wise in your own eyes, and the humility that comes before honor.",
   "deeper": ["pride", "spiritual-pride"]
  },
  {
   "id": "heart",
   "name": "The heart",
   "line": "The inner life Proverbs keeps returning to: joy and sorrow, hope deferred, a crushed spirit, and the heart the LORD searches.",
   "deeper": ["anxiety", "joy"]
  },
  {
   "id": "friends",
   "name": "Friends, neighbors and companions",
   "line": "The friend who loves at all times, the neighbor next door, and the company that shapes who you become.",
   "deeper": ["deep-friendship", "loneliness"]
  },
  {
   "id": "family",
   "name": "Parents and children",
   "line": "A father's and a mother's teaching, the training and correcting of children, and the joy and grief children bring.",
   "deeper": [
    "parenting-struggles",
    "raising-teenagers",
    "wayward-child"
   ]
  },
  {
   "id": "marriage",
   "name": "Marriage and faithfulness",
   "line": "The warnings against adultery, delight in the wife of your youth, the quarrelsome house, and the woman of noble character.",
   "deeper": [
    "marriage-conflict",
    "sexual-purity",
    "cheating"
   ]
  },
  {
   "id": "work",
   "name": "Work and the slacker",
   "line": "The diligent hand and the idle one, the ant at harvest, and the field gone to thorns.",
   "noteTheme": "Work, wealth, and the poor",
   "deeper": ["procrastination-and-laziness", "work-and-burnout"]
  },
  {
   "id": "money",
   "name": "Wealth, poverty and generosity",
   "line": "Riches and their limits, debt and putting up security, the poor man, and the open hand.",
   "noteTheme": "Work, wealth, and the poor",
   "deeper": [
    "money",
    "generosity-and-giving",
    "financial-hardship"
   ]
  },
  {
   "id": "kindness",
   "name": "Kindness and faithfulness",
   "line": "Loving devotion and faithfulness, mercy to the needy, and good done to an enemy.",
   "deeper": ["kindness", "loving-your-enemies"]
  },
  {
   "id": "honest",
   "name": "Honest dealing",
   "line": "Honest scales and unequal weights, bribes, fraud, and wealth gained too quickly.",
   "deeper": ["honesty-and-integrity", "stealing"]
  },
  {
   "id": "justice",
   "name": "Justice, rulers and the king",
   "line": "Kings and rulers, the courts and the witness stand, partiality, and the cause of the poor and the voiceless.",
   "deeper": [
    "justice-and-the-poor"
   ]
  },
  {
   "id": "envy",
   "name": "Envy and revenge",
   "line": "Envying the wicked, fretting over evildoers, gloating over an enemy, and leaving vengeance to the LORD.",
   "deeper": ["envy-and-comparison", "revenge"]
  },
  {
   "id": "appetite",
   "name": "Wine, appetite and self-control",
   "line": "Wine and strong drink, the glutton and the ruler's table, too much honey, and eyes that are never satisfied.",
   "deeper": [
    "alcohol-and-drinking",
    "self-control",
    "overeating"
   ]
  }
 ],
