 "series": {
  "genesis": {
   "book": "genesis",
   "slug": "genesis-sermon-series",
   "title": "Genesis Sermon Series",
   "headline": "Where Everything That Is Wrong Began — and the Promise That It Would Be Made Right",
   "bigIdea": "Genesis is not a science textbook or a children's story. It is the book that explains why the world is glorious and broken at once, and where the rescue was first promised.",
   "christConnection": "The offspring who crushes the serpent (3:15), the lamb God provides in place of the son (22:8), the curse-bearer who becomes blessing for all nations (12:3) — all of it points to Christ.",
   "sermons": [
    {
     "n": "1",
     "text": "Genesis 1–2",
     "title": "Made, Not Random",
     "idea": "You are not an accident. You are made, in His image, on purpose.",
     "verdict": "You bear the image you did not earn."
    },
    {
     "n": "2",
     "text": "Genesis 3",
     "title": "The Day It Broke",
     "idea": "Sin is not breaking a rule. It is the refusal to be a creature.",
     "verdict": "Every wrong began with one grasp."
    },
    {
     "n": "3",
     "text": "Genesis 6–9",
     "title": "Judgment and the Ark",
     "idea": "God's judgment and God's mercy meet in one door.",
     "verdict": "There is room in the ark."
    },
    {
     "n": "4",
     "text": "Genesis 12",
     "title": "The Call of Abram",
     "idea": "God's plan to bless the world runs through one undeserving man.",
     "verdict": "Blessed to be a blessing."
    },
    {
     "n": "5",
     "text": "Genesis 22",
     "title": "The Mountain and the Lamb",
     "idea": "God provides the sacrifice He requires.",
     "verdict": "God Himself will provide the lamb."
    },
    {
     "n": "6",
     "text": "Genesis 37–50",
     "title": "Meant for Good",
     "idea": "What men intend for evil, God weaves for salvation.",
     "verdict": "You meant evil; God meant good."
    }
   ]
  },
  "john": {
   "book": "john",
   "slug": "john-sermon-series",
   "title": "John Sermon Series",
   "headline": "The Signs Were Never the Point. The One They Pointed To Was.",
   "bigIdea": "John selects seven signs and seven 'I AM' sayings to make one case: Jesus is God in the flesh, and believing Him is life.",
   "christConnection": "This is the most explicitly Christ-centered book in the canon; the connection is not drawn, it is the text.",
   "sermons": [
    {
     "n": "1",
     "text": "John 1:1–18",
     "title": "The Word Became Flesh",
     "idea": "The infinite God took on a body you could touch.",
     "verdict": "The Word moved into the neighborhood."
    },
    {
     "n": "2",
     "text": "John 3",
     "title": "Born Again",
     "idea": "You do not need improvement. You need a new birth.",
     "verdict": "You must be born from above."
    },
    {
     "n": "3",
     "text": "John 4",
     "title": "The Woman at the Well",
     "idea": "Jesus offers living water to the person everyone else avoided.",
     "verdict": "He went where He didn't have to go."
    },
    {
     "n": "4",
     "text": "John 11",
     "title": "I Am the Resurrection",
     "idea": "Jesus weeps at the grave and then empties it.",
     "verdict": "He wept at the tomb He would open."
    },
    {
     "n": "5",
     "text": "John 13",
     "title": "The Towel and the Basin",
     "idea": "The Lord of all kneels to wash feet.",
     "verdict": "The throne was a basin."
    },
    {
     "n": "6",
     "text": "John 19–20",
     "title": "It Is Finished",
     "idea": "The cross is not a defeat to be reversed but a victory to be announced.",
     "verdict": "Finished — and then He rose."
    }
   ]
  },
  "philippians": {
   "book": "philippians",
   "slug": "philippians-sermon-series",
   "title": "Philippians Sermon Series",
   "headline": "A Man in Chains Wrote the Happiest Letter in the Bible. Ask Why.",
   "bigIdea": "Paul writes from prison about a joy that circumstances cannot reach because its source is not circumstantial.",
   "christConnection": "The hymn of 2:5–11 — Christ's descent and exaltation — is the engine of the whole letter's joy and humility.",
   "sermons": [
    {
     "n": "1",
     "text": "Philippians 1",
     "title": "To Live Is Christ",
     "idea": "When Christ is your life, even death becomes gain.",
     "verdict": "To live is Christ, to die is gain."
    },
    {
     "n": "2",
     "text": "Philippians 2:1–11",
     "title": "The Mind That Moves Down",
     "idea": "The path to exaltation runs through descent.",
     "verdict": "He humbled Himself."
    },
    {
     "n": "3",
     "text": "Philippians 3",
     "title": "Counting It Loss",
     "idea": "Everything you'd boast in is rubbish next to knowing Him.",
     "verdict": "Loss, for the surpassing worth."
    },
    {
     "n": "4",
     "text": "Philippians 4",
     "title": "The Peace That Guards",
     "idea": "Anxiety answered by prayer becomes peace standing guard.",
     "verdict": "Peace will guard your heart."
    }
   ]
  }
 },
